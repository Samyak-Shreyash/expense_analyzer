{
  "name": "expense-analyzer-mobile",
  "version": "0.0.0",
  "main": "expo-router/entry",
  "dependencies": {
    "@expense-analyzer/api-client": "file:../packages/api-client",
    "expo": "~58.0.22",
    "expo-constants": "~58.0.14",
    "expo-crypto": "~58.0.7",
    "expo-linking": "~58.0.15",
    "expo-local-authentication": "~58.0.2",
    "expo-router": "~58.0.29",
    "expo-secure-store": "~58.0.2",
    "expo-splash-screen": "~58.0.12",
    "expo-status-bar": "~58.0.4",
    "expo-system-ui": "~58.0.7",
    "react": "19.3.1",
    "react-dom": "19.3.0",
    "react-native": "0.88.1",
    "react-native-safe-area-context": "~5.11.1",
    "react-native-screens": "~4.30.1"
  },
  "devDependencies": {
    "@testing-library/react-native": "^14.1.0",
    "@types/jest": "30.0.0",
    "@types/react": "~19.3.0",
    "eslint": "^9.39.5",
    "eslint-config-expo": "~58.0.4",
    "eslint-config-prettier": "^10.1.8",
    "jest": "~30.5.2",
    "jest-expo": "~58.0.13",
    "prettier": "^3.9.10",
    "typescript": "~7.0.2"
  },
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc --noEmit",
    "test": "jest",
    "ci": "npm run lint && npm run format:check && npm run typecheck && npm test"
  },
  "private": true,
  "jest": {
    "preset": "jest-expo",
    "modulePaths": [
      "<rootDir>/node_modules"
    ]
  },
  "overrides": {
    "glob": "^14.0.2",
    "minimatch": "^11.0.1"
  }
}
