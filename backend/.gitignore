# ============================================================
# Git Ignore File for Expense Analyzer Backend
# Excludes unnecessary files from version control
# ============================================================

# Build artifacts
build/
target/
*.jar
*.class

# IDE and editor files
.idea/
.vscode/
*.iml
.settings/
.project
.classpath

# OS files
.DS_Store
Thumbs.db
*.swp
*.swo
*~

# Environment files (use .env.example as template)
.env
.env.local
.env.*.local

# Docker configuration (managed separately)
docker-compose.yml
Dockerfile
otel-config/
prometheus.yml

# Logs
logs/
*.log

# Temporary files
*.tmp
*.temp
