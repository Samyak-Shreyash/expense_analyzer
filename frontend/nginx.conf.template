# nginx's entrypoint fills ${BACKEND_URL} from the environment at container start.
server {
    listen 80;
    root /usr/share/nginx/html;

    # Same-origin API: the backend has no CORS config (see docs/frontend/FRONTEND-STACK.md).
    location /api/ {
        proxy_pass ${BACKEND_URL};
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    # Client-side routes (/login, /dashboard, ...) all serve the SPA.
    location / {
        try_files $uri /index.html;
    }
}
