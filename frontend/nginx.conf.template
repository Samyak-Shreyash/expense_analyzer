# nginx's entrypoint fills ${BACKEND_URL} from the environment at container start.
server {
    listen 80;
    root /usr/share/nginx/html;

    # Same-origin API: the backend has no CORS config (see docs/frontend/FRONTEND-STACK.md).
    location /api/ {
        client_max_body_size 22m; # matches spring.servlet.multipart.max-request-size
        proxy_pass ${BACKEND_URL};
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    # Client-side routes (/login, /dashboard, ...) all serve the SPA.
    location / {
        add_header Content-Security-Policy "default-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; object-src 'none'; base-uri 'self'; frame-ancestors 'none'" always;
        add_header Strict-Transport-Security "max-age=31536000" always;
        add_header X-Content-Type-Options "nosniff" always;
        add_header Referrer-Policy "same-origin" always;
        try_files $uri /index.html;
    }
}
